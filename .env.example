# --- Admin (/admin) ---
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Storage ---
# Leave empty to store admin edits + uploads in ./data (VPS / Docker / local).
# Set for serverless hosts like Vercel, where the filesystem is read-only:
MONGODB_URI=
MONGODB_DB=portfolio

# --- Optional ---
# Higher GitHub API rate limits + official contribution calendar
GITHUB_TOKEN=
# Canonical URL used for social preview images
NEXT_PUBLIC_SITE_URL=

# --- Contact form notifications (optional, via resend.com) ---
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Website previews (optional) ---
# Free tier works without a key; add one for higher limits (microlink.io)
MICROLINK_API_KEY=
